// ============================================================================
// GRAMÁTICA COMPLETA
// ============================================================================
// program, var, begin/end, write, :=, expresiones aritméticas.
// if/then/else, while/do, for(init;cond;incr), comparaciones, and.
// array [N] of int, arr[i], function f(a: int) : int { ... }
//
// Los terminales se definen en lexer/terminals.lark.

?start: program

// --- Estructura del programa ------------------------------------------------
// program main { declaraciones, funciones opcionales, begin; ... end; }
program: PROGRAM MAIN LBRACE top_level_items RBRACE

top_level_items: top_level_item*

top_level_item: decls
              | function_def
              | stmt_section

// --- Declaraciones ----------------------------------------------------------
// var i, n : int;
// var nums : array [5] of int;          (sintaxis "of": índices 0 .. N-1)
// var i, j, datos[6] : int;             (sintaxis inline: datos es arreglo)
decls: VAR decl_item (COMMA decl_item)* SEMICOLON

decl_item: declarator_list COLON type_spec

declarator_list: declarator (COMMA declarator)*

declarator: IDENT                        -> scalar_declarator
          | IDENT LBRACK INTEGER RBRACK  -> array_declarator

ident_list: IDENT (COMMA IDENT)*

type_spec: INT_KW -> int_type
         | ARRAY LBRACK INTEGER RBRACK OF INT_KW -> array_type

// --- Funciones --------------------------------------------------------------
// function suma(a, b : int) : int { begin; suma := a + b; end; }
// function proc() { begin; ... end; }   (sin tipo de retorno → procedimiento)
function_def: FUNCTION IDENT LPAR param_list? RPAR (COLON INT_KW)? LBRACE stmt_section RBRACE

param_list: param_group (COMMA param_group)*

param_group: ident_list COLON INT_KW

// --- Sección de sentencias (entre begin; y end;) ----------------------------
stmt_section: BEGIN SEMICOLON stmt_list END SEMICOLON

stmt_list: stmt*

// --- Sentencias -------------------------------------------------------------
?stmt: assign_stmt
     | write_stmt
     | if_stmt
     | while_stmt
     | for_stmt
     | postfix_stmt
     | call_stmt

// --- Llamada a función como sentencia: proc(); ------------------------------
call_stmt: IDENT LPAR arg_list? RPAR SEMICOLON

// --- Asignación: variable o arreglo[index] := expresión; --------------------
// Se admite un literal como destino (lvalue inválido) para que el análisis
// semántico lo reporte como error en lugar de fallar en el parser.
assign_stmt: assignable ASSIGN expr SEMICOLON

assignable: IDENT -> var_lvalue
          | IDENT LBRACK expr RBRACK -> array_lvalue
          | INTEGER -> int_lvalue

// --- Write: write(expr) o write("cadena"); ---------------------------------
write_stmt: WRITE LPAR write_arg RPAR SEMICOLON

write_arg: expr | STRING

// --- If / then / else -------------------------------------------------------
if_stmt: IF LPAR condition RPAR THEN block else_clause?

else_clause: ELSE block
           | ELSE if_stmt

// --- While / do -------------------------------------------------------------
while_stmt: WHILE LPAR condition RPAR DO block

// --- For --------------------------------------------------------------------
for_stmt: FOR LPAR for_init SEMICOLON condition SEMICOLON for_update RPAR block

for_init: IDENT ASSIGN expr

for_update: IDENT INC   -> for_inc
          | IDENT DEC   -> for_dec
          | IDENT ASSIGN expr -> for_assign

// --- Post-incremento / decremento como sentencia: n--; ---------------------
postfix_stmt: IDENT DEC SEMICOLON -> dec_stmt
            | IDENT INC SEMICOLON -> inc_stmt

// --- Bloque: { sentencia* } ------------------------------------------------
block: LBRACE stmt_list RBRACE

// --- Condiciones (expresiones booleanas) ------------------------------------
// Precedencia: or < and < not < comparación
?condition: or_cond

?or_cond: and_cond
        | or_cond OR and_cond    -> or_

?and_cond: not_cond
         | and_cond AND not_cond -> and_

?not_cond: cond_atom
         | NOT not_cond          -> not_

cond_atom: LPAR condition RPAR -> paren_cond
         | expr GT expr        -> cmp_gt
         | expr LT expr        -> cmp_lt
         | expr GE expr        -> cmp_ge
         | expr LE expr        -> cmp_le
         | expr EQ expr        -> cmp_eq
         | expr NE expr        -> cmp_ne
         | expr                -> expr_cond

// --- Expresiones aritméticas ------------------------------------------------
?expr: sum

?sum: product
    | sum PLUS product   -> add
    | sum MINUS product  -> sub

?product: unary
        | product STAR unary    -> mul
        | product SLASH unary   -> div
        | product PERCENT unary -> mod

?unary: primary
      | MINUS unary -> neg

?primary: call_expr
        | var_ref
        | INTEGER           -> int_lit
        | LPAR expr RPAR    -> paren

// Llamada a función: suma(3, 4)
call_expr: IDENT LPAR arg_list? RPAR -> call

arg_list: expr (COMMA expr)*

// Variable simple o acceso a arreglo: x  /  nums[i]
var_ref: IDENT -> var_ref
       | IDENT LBRACK expr RBRACK -> array_ref
