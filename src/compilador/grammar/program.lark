// ============================================================================
// GRAMÁTICA COMPLETA — Fases 2 y 3
// ============================================================================
// Fase 2: program, var, begin/end, write, :=, expresiones aritméticas.
// Fase 3: if/then/else, while/do, for(init;cond;incr), comparaciones, and.
//
// Los terminales se definen en lexer/terminals.lark (compuestos en Python
// mediante lark_util.compose_lark). Esta gramática solo contiene reglas
// sintácticas (no-terminales).
// ============================================================================

?start: program

// --- Estructura del programa ------------------------------------------------
// Un programa siempre sigue: program main { declaraciones begin; ... end; }
program: PROGRAM MAIN LBRACE decls stmt_section RBRACE

// --- Declaraciones ----------------------------------------------------------
// Solo soporta un bloque "var" con tipo int (según los archivos de pruebas/)
decls: VAR ident_list COLON INT_KW SEMICOLON

ident_list: IDENT (COMMA IDENT)*

// --- Sección de sentencias (entre begin; y end;) ----------------------------
stmt_section: BEGIN SEMICOLON stmt_list END SEMICOLON

stmt_list: stmt*

// --- Sentencias -------------------------------------------------------------
// Cada sentencia puede ser: asignación, write, if, while, for, o post-inc/dec
?stmt: assign_stmt
     | write_stmt
     | if_stmt
     | while_stmt
     | for_stmt
     | postfix_stmt

// --- Asignación: variable := expresión; ------------------------------------
assign_stmt: IDENT ASSIGN expr SEMICOLON

// --- Write: write(expr) o write("cadena"); ---------------------------------
write_stmt: WRITE LPAR write_arg RPAR SEMICOLON

write_arg: expr | STRING

// --- If / then / else -------------------------------------------------------
// Forma: if (condición) then { ... } else { ... }
// El else es opcional (pruebaIf.txt usa else, pruebaErrores.txt también)
if_stmt: IF LPAR condition RPAR THEN block else_clause?

else_clause: ELSE block
           | ELSE if_stmt

// --- While / do -------------------------------------------------------------
// Forma: while (condición) do { ... }
while_stmt: WHILE LPAR condition RPAR DO block

// --- For --------------------------------------------------------------------
// Forma: for (init; cond; incr) { ... }
// init es asignación, cond es condición, incr es asignación o postfix
for_stmt: FOR LPAR for_init SEMICOLON condition SEMICOLON for_update RPAR block

for_init: IDENT ASSIGN expr

for_update: IDENT INC   -> for_inc
          | IDENT DEC   -> for_dec
          | IDENT ASSIGN expr -> for_assign

// --- Post-incremento / decremento como sentencia: n--; ---------------------
postfix_stmt: IDENT DEC SEMICOLON -> dec_stmt
            | IDENT INC SEMICOLON -> inc_stmt

// --- Bloque: { sentencia* } ------------------------------------------------
block: LBRACE stmt_list RBRACE

// --- Condiciones (expresiones booleanas) ------------------------------------
// Soporta: comparaciones simples y "and" entre condiciones.
// "and" une dos condiciones (pruebaErrores.txt: (a>b) and (expr))
//
// Diseño: una condición es una lista de "cond_atom" unidos por AND.
// Cada cond_atom puede ser:
//   - Una comparación sin paréntesis: expr OP expr
//   - Un átomo entre paréntesis que internamente es comparación o expr
//
// Para evitar ambigüedad con factor: LPAR expr RPAR (que es aritmética),
// las comparaciones aparecen en un contexto propio (dentro de if/while/for).
// El LALR parser puede distinguirlos porque condition solo aparece tras IF/WHILE/FOR LPAR.
//
// El chequeo de que expr_cond sea booleano es responsabilidad de Fase 5.
condition: cond_atom (AND cond_atom)* -> condition

// Un átomo de condición puede estar entre paréntesis o ser una comparación directa.
// paren_cond resuelve el caso de pruebaErrores: ( a>b ) y ( expr )
cond_atom: LPAR condition RPAR -> paren_cond
         | expr GT expr        -> cmp_gt
         | expr LT expr        -> cmp_lt
         | expr GE expr        -> cmp_ge
         | expr                -> expr_cond

// --- Expresiones aritméticas ------------------------------------------------
// Precedencia: + - (suma) < * (producto) < átomo
?expr: sum

?sum: product
    | sum PLUS product   -> add
    | sum MINUS product  -> sub

?product: factor
        | product STAR factor -> mul

?factor: IDENT
       | INTEGER
       | LPAR expr RPAR
